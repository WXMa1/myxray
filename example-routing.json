{
  "routing": {
    "domainStrategy": "AsIs",
    "balancers": [
      {
        "tag": "weighted-proxy",
        "selector": ["proxy-"],
        "strategy": {
          "type": "weightedRoundRobin",
          "settings": {
            "weights": [
              {
                "regexp": false,
                "match": "proxy-a",
                "value": 5
              },
              {
                "regexp": false,
                "match": "proxy-b",
                "value": 3
              },
              {
                "regexp": false,
                "match": "proxy-c",
                "value": 2
              }
            ]
          }
        },
        "fallbackTag": "direct"
      }
    ],
    "rules": [
      {
        "type": "field",
        "network": "tcp,udp",
        "balancerTag": "weighted-proxy"
      }
    ]
  }
}
